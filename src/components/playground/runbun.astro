---
import { extractRunBunFiles, type RunBunFile } from './runbun-files';

type Mode = 'code' | 'console' | 'preview' | 'full' | 'result';

interface Props {
	/** Playground mode. `preview` runs the server beside the code. */
	mode?: Mode;
	/** Extra files to add to the playground, keyed by path. */
	files?: Record<string, string>;
	/** Dependencies written to the generated package.json. */
	dependencies?: Record<string, string>;
	/** File opened first. Defaults to the first code block. */
	file?: string;
	/** Path the preview's first tab opens, e.g. "/user/123". Defaults to "/". */
	path?: string;
	/** CSS height of the embed. Defaults to the poster's height until it starts, then the mode's. */
	height?: string;
	/** When the embed starts. Unset, the page default (runbun-defaults.astro): a click on the static code. */
	load?: 'visible' | 'eager' | 'click';
	/** Expand button mode, or false to hide the button. Unset, the page default (runbun-defaults.astro): `full`. */
	expand?: Mode | false;
	features?: string;
	/** Runbun theme family (by its light variant), kept while `theme` follows the page. Unset, the page default (runbun-defaults.astro). */
	family?: string;
	/** Stylesheet URLs loaded inside the embed, whitespace-separated. Unset, the page default (runbun-defaults.astro). */
	fonts?: string;
	title?: string;
	class?: string;
}

const {
	mode = 'preview',
	files: extraFiles = {},
	dependencies = { elysia: 'rc' },
	file,
	path,
	height,
	load,
	expand,
	features,
	family,
	fonts,
	title = 'Elysia playground',
	class: className
} = Astro.props;

const slotFiles = extractRunBunFiles(await Astro.slots.render('default'));
const packageJson = {
	name: 'elysia-playground',
	dependencies
};
const files: RunBunFile[] = [
	{ path: 'package.json', code: JSON.stringify(packageJson, null, 2) },
	...slotFiles,
	...Object.entries(extraFiles).map(([path, code]) => ({ path, code }))
];
const entry = file ?? slotFiles[0]?.path ?? 'index.ts';

const escapeScript = (code: string) =>
	code
		.replace(/<\/script/gi, '<\\/script')
		.replace(/<!--/g, '<\\!--');
---

<div
	class:list={[
		'runbun-playground spica-surface spica-card not-content my-6 grid min-w-0 gap-2 rounded-3xl border border-border bg-surface p-1.5 font-sans shadow-xs',
		className
	]}
	data-tone="light"
>
	<div class="min-w-0 text-sm leading-[1.55] text-pretty text-ink-soft">
		<div class="code-playground__code min-w-0 [--code-surface-wash:var(--color-base)] [&_.expressive-code]:m-0! [&_.expressive-code_.frame]:border-0! [&_.expressive-code_.frame]:p-0! [&_.expressive-code_.frame]:shadow-none!">
			<bun-playground
				class="block overflow-hidden rounded-2xl"
				style="--poster-bg: transparent; --poster-fg: var(--color-ink); --play-bg: var(--color-primary); --play-bg-hover: var(--color-primary-cta-deep); --play-fg: var(--color-on-primary); --play-border: var(--color-primary); --play-radius: 0.75rem; --play-font: var(--font-sans);"
				mode={mode}
				file={entry}
				path={path}
				height={height ?? 'auto'}
				load={load}
				expand={expand === false ? 'false' : expand}
				features={features}
				family={family}
				fonts={fonts}
				title={title}
			>
				<div slot="poster">
					<slot />
				</div>
				{
					files.map(({ path, code }) => (
						<script
							type="text/plain"
							data-file={path}
							set:html={escapeScript(code)}
							is:inline
						></script>
					))
				}
			</bun-playground>
		</div>
	</div>
</div>

<style>
	/* The playground is a featured surface, drawn on the embed's overlay part: it sits above the poster and the frame
	   (in its modal too) and lets clicks through, so the look survives the frame loading. The iris wash is its fill (the
	   poster's own code surface is plain for it), the magic hairline (--gradient-magic-strong) its 1px ring. */
	bun-playground::part(overlay) {
		border-radius: var(--radius-2xl);
		background: var(--surface-wash-iris-glow);
	}

	@supports (mask-composite: exclude) or (-webkit-mask-composite: xor) {
		bun-playground::part(overlay)::after {
			content: '';
			position: absolute;
			inset: 0;
			padding: 1px;
			border-radius: inherit;
			background: var(--gradient-magic-strong);
			-webkit-mask:
				linear-gradient(#000 0 0) content-box,
				linear-gradient(#000 0 0);
			-webkit-mask-composite: xor;
			mask:
				linear-gradient(#000 0 0) content-box,
				linear-gradient(#000 0 0);
			mask-composite: exclude;
		}
	}
</style>

<script is:inline>
	(() => {
		if (!document.querySelector('script[data-runbun-embed]')) {
			// The page defaults' `src` is the origin (production unless PUBLIC_RUNBUN_ORIGIN sets another; see
			// runbun-defaults.astro).
			const origin =
				document
					.querySelector('bun-playground-defaults')
					?.getAttribute('src') ||
				document.querySelector('bun-playground')?.getAttribute('src') ||
				'https://runbun.dev';
			const script = document.createElement('script');
			script.type = 'module';
			script.src = `${origin}/embed.js`;
			script.dataset.runbunEmbed = '';
			document.head.append(script);
		}

		// The embed is cross-origin, so it can't see the page's CSS. Read the tokens it should mirror and hand them
		// over as CSS variables; runbun merges them over its theme's (see its embed API's `vars`).
		const chrome = () => {
			const style = getComputedStyle(document.documentElement);
			const token = (name) => style.getPropertyValue(name).trim();

			return JSON.stringify({
				base: {
					'--bg': token('--color-base'),
					'--canvas': token('--color-surface'),
					'--panel': token('--color-surface'),
					'--fg': token('--color-ink'),
					'--muted': token('--color-ink-muted'),
					'--border': token('--color-border'),
					'--accent': token('--color-primary'),
					'--error': token('--color-danger-deep'),
					'--ok': token('--color-success-deep'),
					'--warn': token('--color-warning-deep'),
					'--radius': '1rem',
					'--font-ui': token('--font-sans'),
					'--font-mono': token('--font-mono')
				}
			});
		};

		// Set on the page defaults (runbun-defaults.astro): every embed follows them, live once it runs.
		const syncTheme = () => {
			const defaults = document.querySelector('bun-playground-defaults');
			if (!defaults) return;

			defaults.setAttribute(
				'theme',
				document.documentElement.dataset.theme === 'light'
					? 'light'
					: 'dark'
			);
			defaults.setAttribute('vars', chrome());
		};

		if (!window.__runbunThemeSync) {
			window.__runbunThemeSync = true;
			new MutationObserver(syncTheme).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme']
			});
			document.addEventListener('astro:page-load', syncTheme);
			document.addEventListener('DOMContentLoaded', syncTheme, {
				once: true
			});
		}

		syncTheme();
	})();
</script>
